            "type": "text/javascript",
            "exec": [
              "pm.test(\"Duplicate registration is rejected\", function () {",
              "    pm.expect(pm.response.code).to.be.at.least(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Login with Valid Credentials (200 OK - fresh JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{urlMsAuth}}/auth/login",
          "host": [
            "{{urlMsAuth}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "if (jsonData.accessToken) { pm.collectionVariables.set(\"accessToken\", jsonData.accessToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "5. [Error] Login with Invalid Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{urlMsAuth}}/auth/login",
          "host": [
            "{{urlMsAuth}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Invalid credentials are rejected\", function () {",
              "    pm.expect(pm.response.code).to.be.at.least(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Validate JWT (200 OK - valid claims)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{urlMsAuth}}/auth/validate",
          "host": [
            "{{urlMsAuth}}"
          ],
          "path": [
            "auth",
            "validate"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Token is valid and belongs to the registered user\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.valid).to.eql(true);",
              "    pm.expect(jsonData.username).to.eql(pm.collectionVariables.get(\"username\"));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Validate ADMIN JWT (200 OK - ROLE_ADMIN claim)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{urlMsAuth}}/auth/validate",
          "host": [
            "{{urlMsAuth}}"
          ],
          "path": [
            "auth",
            "validate"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Admin token carries ROLE_ADMIN\", function () { pm.expect(pm.response.json().role).to.eql(\"ROLE_ADMIN\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. [Error] Validate Token without Authorization Header",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{urlMsAuth}}/auth/validate",
          "host": [
            "{{urlMsAuth}}"
          ],
          "path": [
