{
  "info": {
    "_postman_id": "e5f6a7b8-c9d0-4e1f-8a2b-3c4d5e6f7a8b",
    "name": "Pivot Banking - ms-auth (Phase III)",
    "description": "Postman Collection for pivot-ms-auth (Phase III): user registration, BCrypt login, HS256 JWT issuance and token validation. The gateway exposes /api/v1/auth/** as a public route; on protected routes it validates the same token and propagates X-Auth-User, X-Auth-Role and X-Auth-Customer-Id. Secrets (jwt-secret-key, jwt-expiration-ms) come from Vault secret/pivot-bank. Zero outbound REST calls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register ROLE_USER (201 Created - JWT issued)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{urlMsAuth}}/auth/register",
          "host": [
            "{{urlMsAuth}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"daniel.singer@pivotbank.pe\",\n  \"password\": \"{{password}}\",\n  \"role\": \"ROLE_USER\",\n  \"customerId\": \"{{customerId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () { pm.response.to.have.status(201); });",
              "var jsonData = pm.response.json();",
              "if (jsonData.accessToken) { pm.collectionVariables.set(\"accessToken\", jsonData.accessToken); }",
              "pm.test(\"Token type is Bearer\", function () { pm.expect(jsonData.tokenType).to.eql(\"Bearer\"); });",
              "pm.test(\"Role is ROLE_USER\", function () { pm.expect(jsonData.role).to.eql(\"ROLE_USER\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Register ROLE_ADMIN (201 Created)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{urlMsAuth}}/auth/register",
          "host": [
            "{{urlMsAuth}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"email\": \"admin@pivotbank.pe\",\n  \"password\": \"{{adminPassword}}\",\n  \"role\": \"ROLE_ADMIN\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () { pm.response.to.have.status(201); });",
              "var jsonData = pm.response.json();",
              "if (jsonData.accessToken) { pm.collectionVariables.set(\"adminToken\", jsonData.accessToken); }",
              "pm.test(\"Role is ROLE_ADMIN\", function () { pm.expect(jsonData.role).to.eql(\"ROLE_ADMIN\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. [Error] Register Duplicate Username",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{urlMsAuth}}/auth/register",
          "host": [
            "{{urlMsAuth}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"duplicate.daniel@pivotbank.pe\",\n  \"password\": \"Another2026!\",\n  \"role\": \"ROLE_USER\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
